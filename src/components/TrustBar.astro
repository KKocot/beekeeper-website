---
const ecosystemProjects = [
  "Hive",
  "Wax",
  "HiveSigner",
  "PeakD",
  "Splinterlands",
  "Hive.blog",
  "Ecency",
];
---

<section aria-label="Hive ecosystem partners" class="border-y border-border-subtle bg-bg-elevated/50 py-16">
  <div class="mx-auto max-w-6xl px-6">
    <p
      class="mb-8 text-center text-sm uppercase tracking-widest text-text-tertiary"
    >
      Powering the Hive ecosystem
    </p>
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
      {
        ecosystemProjects.map((name) => (
          <span class="cursor-default rounded-full border border-border-subtle bg-bg-subtle/50 px-4 py-1.5 text-sm font-medium text-text-tertiary opacity-60 transition duration-300 hover:text-text-secondary hover:opacity-100">
            {name}
          </span>
        ))
      }
    </div>
  </div>
</section>

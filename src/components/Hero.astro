---
import CopyButton from "./CopyButton.tsx";
import HoneycombBackground from "./HoneycombBackground.astro";
---

<section id="hero" aria-labelledby="hero-heading" class="relative overflow-hidden py-24 md:py-32">
  <!-- Animated honeycomb background -->
  <HoneycombBackground />

  <!-- Upper area: text -->
  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
    <!-- Badge -->
    <div class="hero-fade-up" style="animation-delay: 0ms;">
      <span
        class="inline-block rounded-full bg-accent-muted px-3 py-1 text-sm text-accent"
      >
        Open Source &middot; MIT License
      </span>
    </div>

    <!-- Headline -->
    <h1
      id="hero-heading"
      class="hero-fade-up mt-6 text-5xl font-extrabold leading-tight tracking-tight text-text-primary md:text-6xl lg:text-7xl"
      style="animation-delay: 100ms;"
    >
      Secure key management for Hive blockchain
    </h1>

    <!-- Subheadline -->
    <p
      class="hero-fade-up mx-auto mt-6 max-w-2xl text-lg text-text-secondary md:text-xl"
      style="animation-delay: 200ms;"
    >
      Standalone wallet daemon with HTTP & WebSocket API. Sign transactions
      without running a full node. Available as native C++ daemon, npm
      package, and Python SDK.
    </p>

    <!-- CTAs -->
    <div
      class="hero-fade-up mt-8 flex flex-wrap items-center justify-center gap-4"
      style="animation-delay: 300ms;"
    >
      <CopyButton client:load />
      <a
        href="https://gitlab.syncad.com/hive/beekeeper"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-border-subtle px-6 py-3 text-text-secondary transition hover:text-text-primary"
      >
        View Source Code
      </a>
    </div>
  </div>

  <!-- Lower area: terminal preview -->
  <div
    class="hero-fade-up relative z-10 mx-auto mt-16 max-w-3xl px-4"
    style="animation-delay: 500ms;"
  >
    <div
      class="overflow-hidden rounded-xl border border-border-subtle bg-code-bg shadow-lg shadow-accent/5"
    >
      <!-- Terminal titlebar -->
      <div
        class="flex items-center border-b border-border-subtle px-4 py-3"
      >
        <div class="flex gap-2" aria-hidden="true">
          <span class="h-3 w-3 rounded-full bg-error"></span>
          <span class="h-3 w-3 rounded-full bg-[#FBBF24]"></span>
          <span class="h-3 w-3 rounded-full bg-success"></span>
        </div>
        <span class="ml-3 text-sm text-text-tertiary">beekeeper</span>
      </div>

      <!-- Terminal body -->
      <div class="p-6 font-mono text-sm leading-relaxed">
        <div class="terminal-line-cmd">
          <span class="text-text-tertiary select-none">$ </span><span
            class="text-accent"
            >beekeeper --webserver-http-endpoint=127.0.0.1:5001</span
          >
        </div>
        <div class="terminal-line-out" style="animation-delay: 1s;">
          <span class="text-text-secondary"
            >Starting Beekeeper v1.27...</span
          >
        </div>
        <div class="terminal-line-out" style="animation-delay: 1.5s;">
          <span class="text-text-secondary"
            >Listening on 127.0.0.1:5001</span
          >
        </div>
        <div class="terminal-line-out" style="animation-delay: 2s;">
          <span class="text-text-secondary"
            >Ready to manage your keys securely</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero entrance animation */
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-up {
    opacity: 0;
    animation: fade-up 0.6s ease-out forwards;
  }

  /* Terminal typewriter effect for command line */
  @keyframes typewriter {
    from {
      max-width: 0;
    }
    to {
      max-width: 100%;
    }
  }

  @keyframes blink-caret {
    from,
    to {
      border-color: transparent;
    }
    50% {
      border-color: var(--color-accent);
    }
  }

  .terminal-line-cmd {
    overflow: hidden;
    white-space: nowrap;
    max-width: 0;
    animation:
      typewriter 0.8s steps(48, end) 0.6s forwards;
  }

  /* Terminal output lines: fade in sequentially */
  @keyframes line-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .terminal-line-out {
    opacity: 0;
    animation: line-fade-in 0.4s ease-out forwards;
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .hero-fade-up {
      opacity: 1;
      animation: none;
    }

    .terminal-line-cmd {
      max-width: 100%;
      animation: none;
    }

    .terminal-line-out {
      opacity: 1;
      animation: none;
    }
  }
</style>

---
const features = [
  {
    title: "Native & WASM",
    description:
      "Run as a C++ HTTP daemon or use the npm package directly in browser and Node.js",
    icon: "dual-build",
  },
  {
    title: "Secure Key Isolation",
    description:
      "Private keys never leave the process. Sign transactions without exposing secrets",
    icon: "key-isolation",
  },
  {
    title: "Multi-Session Support",
    description:
      "Token-based sessions with concurrent access. Multiple users, one daemon",
    icon: "sessions",
  },
  {
    title: "Auto-Lock Timeout",
    description:
      "Wallets automatically lock after configurable inactivity period. Default 900s",
    icon: "auto-lock",
  },
  {
    title: "22 API Endpoints",
    description:
      "Complete JSON-RPC API over HTTP and WebSocket. Create, sign, encrypt — all via API",
    icon: "json-rpc",
  },
  {
    title: "Built-in Encryption",
    description:
      "Diffie-Hellman memo-style encrypt/decrypt. Secure messaging without extra libraries",
    icon: "encryption",
  },
  {
    title: "Python SDK",
    description:
      "Bundled beekeeper binary, zero config. Sync & async API with context managers. Full type hints, strict mypy compatible",
    icon: "python-sdk",
  },
];
---

<section id="features" aria-labelledby="features-heading" class="px-4 py-24">
  <div class="mx-auto max-w-4xl">
    {/* Section header */}
    <div class="mb-16 text-center">
      <h2 id="features-heading" class="text-3xl font-bold text-text-primary md:text-4xl">
        What's under the hood
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-text-secondary">
        C++ daemon and WASM library for Hive key operations
      </p>
    </div>

    {/* Feature list — compact stacked layout */}
    <div class="feature-list md:columns-2 md:gap-x-12 lg:gap-x-16">
      {
        features.map((feature, i) => (
          <div
            class="feature-item border-b border-border-subtle py-5 break-inside-avoid"
            style={`transition-delay: ${i * 60}ms`}
          >
            <div class="flex items-start gap-3.5">
              <div class="mt-0.5 shrink-0 text-accent">
                {feature.icon === "dual-build" && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="2" y="2" width="8" height="8" rx="1" />
                    <rect x="14" y="14" width="8" height="8" rx="1" />
                    <path d="M6 10v4h4M18 10V6h-4" />
                  </svg>
                )}
                {feature.icon === "key-isolation" && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.25C17.25 22.15 21 17.25 21 12V7l-9-5z" />
                    <rect x="9.5" y="10" width="5" height="6" rx="0.5" />
                    <path d="M10.5 10V8a1.5 1.5 0 0 1 3 0v2" />
                  </svg>
                )}
                {feature.icon === "sessions" && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="9" cy="7" r="3" />
                    <path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" />
                    <circle cx="18" cy="9" r="2.5" />
                    <path d="M21 21v-1.5a3 3 0 0 0-3-3h-.5" />
                  </svg>
                )}
                {feature.icon === "auto-lock" && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 6v6l4 2" />
                    <path d="M4.5 4.5l1.5 1.5M19.5 4.5l-1.5 1.5" />
                  </svg>
                )}
                {feature.icon === "json-rpc" && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="4" width="18" height="16" rx="2" />
                    <path d="M7 8l-2 4 2 4" />
                    <path d="M17 8l2 4-2 4" />
                    <path d="M14 8l-4 8" />
                  </svg>
                )}
                {feature.icon === "encryption" && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M2 12h4l2-3 3 6 2-6 2 3h4" />
                    <rect x="15" y="2" width="7" height="5" rx="1" />
                    <rect x="2" y="17" width="7" height="5" rx="1" />
                    <path d="M18.5 7v3.5a1 1 0 0 1-1 1h-6" />
                    <path d="M5.5 17v-3.5a1 1 0 0 1 1-1h6" />
                  </svg>
                )}
                {feature.icon === "python-sdk" && (
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 2c-1.7 0-3 .5-3.5 1.5V6c0 .8.7 1.5 1.5 1.5h4c.8 0 1.5.7 1.5 1.5v1H8.5C6.6 10 5 11.6 5 13.5v2c0 1 .5 1.5 1.5 1.5H9v-2c0-1.1.9-2 2-2h4c1.1 0 2-.9 2-2V6.5C17 4 14.5 2 12 2z" />
                    <path d="M12 22c1.7 0 3-.5 3.5-1.5V18c0-.8-.7-1.5-1.5-1.5h-4c-.8 0-1.5-.7-1.5-1.5v-1h7c1.9 0 3.5-1.6 3.5-3.5v-2c0-1-.5-1.5-1.5-1.5H15v2c0 1.1-.9 2-2 2H9c-1.1 0-2 .9-2 2v4.5C7 20 9.5 22 12 22z" />
                    <circle cx="9.5" cy="5" r="0.75" fill="currentColor" stroke="none" />
                    <circle cx="14.5" cy="19" r="0.75" fill="currentColor" stroke="none" />
                  </svg>
                )}
              </div>
              <div class="min-w-0">
                <h3 class="text-[0.9375rem] font-bold leading-snug text-text-primary">
                  {feature.title}
                  {feature.icon === "python-sdk" && (
                    <span class="ml-2 inline-block align-middle rounded-full bg-bg-subtle px-2 py-0.5 text-xs font-normal text-text-tertiary">
                      Linux only
                    </span>
                  )}
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-text-secondary">
                  {feature.description}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feature-item {
    opacity: 0;
    transform: translateY(1rem);
  }

  .feature-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Last item in each column — no bottom border */
  .feature-list > .feature-item:last-child {
    border-bottom: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll(".feature-item");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (prefersReducedMotion) {
    items.forEach((el) => el.classList.add("visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("visible");
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    items.forEach((el) => observer.observe(el));
  }
</script>

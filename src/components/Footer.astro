---
const resources = [
  {
    label: "Documentation",
    href: "https://developers.hive.io",
  },
  {
    label: "GitHub Repository",
    href: "https://gitlab.syncad.com/hive/beekeeper",
  },
  {
    label: "npm Package",
    href: "https://www.npmjs.com/package/@hiveio/beekeeper",
  },
];

const ecosystem = [
  {
    label: "Hive.io",
    href: "https://hive.io",
  },
  {
    label: "Hive Developer Portal",
    href: "https://developers.hive.io",
  },
  {
    label: "GitLab",
    href: "https://gitlab.syncad.com/hive",
  },
];
---

<footer class="border-t border-border-subtle bg-bg-elevated py-12">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-10 md:grid-cols-3">
      {/* Brand column */}
      <div>
        <div class="flex items-center gap-2.5">
          <svg
            width="28"
            height="28"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M16 2L28.124 9V23L16 30L3.876 23V9L16 2Z"
              stroke="currentColor"
              stroke-width="1.5"
              class="text-accent"
              fill="none"></path>
            <path
              d="M16 8L23.062 12V20L16 24L8.938 20V12L16 8Z"
              class="text-accent"
              fill="currentColor"
              fill-opacity="0.15"
              stroke="currentColor"
              stroke-width="1"></path>
            <circle
              cx="16"
              cy="16"
              r="2.5"
              class="text-accent"
              fill="currentColor"></circle>
          </svg>
          <span class="text-lg font-bold text-text-primary">Beekeeper</span>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-text-tertiary">
          Secure key management for Hive blockchain
        </p>
      </div>

      {/* Resources column */}
      <div>
        <h3 class="mb-4 text-sm font-semibold text-text-primary">Resources</h3>
        <ul class="flex flex-col gap-3">
          {
            resources.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-text-secondary transition hover:text-text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Ecosystem column */}
      <div>
        <h3 class="mb-4 text-sm font-semibold text-text-primary">Ecosystem</h3>
        <ul class="flex flex-col gap-3">
          {
            ecosystem.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-text-secondary transition hover:text-text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="mt-8 border-t border-border-subtle pt-8 text-center">
      <p class="text-sm text-text-tertiary">
        MIT License &middot; Built for Hive
      </p>
    </div>
  </div>
</footer>

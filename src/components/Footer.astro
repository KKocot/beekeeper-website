---
const year = new Date().getFullYear();
---

<footer class="border-t border-border-subtle bg-bg-elevated">
  <div class="mx-auto flex min-h-8 max-w-6xl flex-wrap items-center justify-center px-6 py-2 font-mono text-xs text-text-secondary">
    <a
      href="https://gitlab.syncad.com/hive/beekeeper"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Beekeeper repository (opens in new tab)"
      class="rounded-sm text-text-secondary transition hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
    >
      [beekeeper]
    </a>
    <span class="px-2 text-text-tertiary" aria-hidden="true">│</span>
    <span>&copy; {year}</span>
    <span class="px-2 text-text-tertiary" aria-hidden="true">│</span>
    <a
      href="https://gitlab.syncad.com/hive/beekeeper/-/blob/develop/LICENSE.md"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="MIT License (opens in new tab)"
      class="rounded-sm text-text-secondary transition hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
    >
      MIT License
    </a>
    <span class="px-2 text-text-tertiary" aria-hidden="true">│</span>
    <a
      href="https://hive.io"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Hive blockchain (opens in new tab)"
      class="rounded-sm text-text-secondary transition hover:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
    >
      built for <span class="font-semibold text-accent">hive</span>
    </a>
    <span class="px-2 text-text-tertiary" aria-hidden="true">│</span>
    <span class="text-success" aria-label="Status: online">●</span>
  </div>
</footer>

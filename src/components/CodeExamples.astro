---
import CodeTabs from "./CodeTabs.tsx";
---

<section id="api" aria-labelledby="api-heading" class="px-4 py-24">
  <div class="mx-auto max-w-6xl">
    {/* Section header */}
    <div class="mb-16 text-center">
      <span
        class="inline-block rounded-full bg-accent-muted px-3 py-1 text-sm text-accent"
      >
        API
      </span>
      <h2 id="api-heading" class="mt-4 text-3xl font-bold text-text-primary md:text-4xl">
        Simple, powerful API
      </h2>
      <p class="mt-4 text-text-secondary">
        Get started with just a few lines of code
      </p>
    </div>

    <CodeTabs client:visible />
  </div>
</section>

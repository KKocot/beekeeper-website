---
/**
 * HoneycombBackground — animated hexagon grid for Hero section.
 *
 * Pure CSS/SVG. No JS libraries, no canvas.
 * Uses only transform + opacity for GPU-accelerated animations.
 * Respects prefers-reduced-motion.
 */

// Hexagon geometry (pointy-top orientation)
// For a regular hexagon with "radius" r (center to vertex):
//   width  = r * sqrt(3)
//   height = r * 2
// Pointy-top hex grid offsets:
//   col offset = width
//   row offset = height * 0.75
//   odd rows shifted by width / 2

const HEX_RADIUS = 44; // px — gives ~76px wide hexagons
const HEX_W = Math.round(HEX_RADIUS * Math.sqrt(3));       // ~76
const HEX_H = HEX_RADIUS * 2;                               // 88
const ROW_H = HEX_H * 0.75;                                 // 66

const COLS = 18;
const ROWS = 12;

// Hexagon SVG path (pointy-top, centered at 0,0)
function hexPath(r: number): string {
  const pts: string[] = [];
  for (let i = 0; i < 6; i++) {
    const angle = (Math.PI / 180) * (60 * i - 30);
    const x = (r * Math.cos(angle)).toFixed(2);
    const y = (r * Math.sin(angle)).toFixed(2);
    pts.push(`${x},${y}`);
  }
  return `M${pts.join("L")}Z`;
}

const path = hexPath(HEX_RADIUS);

// Which hexagons get the "pulse glow" animation
// Spread across the grid for natural look — 8 hexagons with staggered delays
const glowHexes: Array<{ row: number; col: number; delay: number }> = [
  { row: 1, col: 3, delay: 0 },
  { row: 3, col: 8, delay: 0.7 },
  { row: 2, col: 14, delay: 1.4 },
  { row: 5, col: 5, delay: 2.1 },
  { row: 7, col: 11, delay: 2.8 },
  { row: 4, col: 1, delay: 3.5 },
  { row: 8, col: 15, delay: 0.35 },
  { row: 9, col: 7, delay: 1.75 },
];

const glowSet = new Set(glowHexes.map((g) => `${g.row}-${g.col}`));

function getGlowDelay(row: number, col: number): number | null {
  const hex = glowHexes.find((g) => g.row === row && g.col === col);
  return hex ? hex.delay : null;
}

// Build hex positions
interface HexCell {
  cx: number;
  cy: number;
  row: number;
  col: number;
  glow: boolean;
  glowDelay: number | null;
}

const hexCells: HexCell[] = [];

for (let row = 0; row < ROWS; row++) {
  for (let col = 0; col < COLS; col++) {
    const isOddRow = row % 2 === 1;
    const cx = col * HEX_W + (isOddRow ? HEX_W / 2 : 0);
    const cy = row * ROW_H;
    const glow = glowSet.has(`${row}-${col}`);
    hexCells.push({
      cx,
      cy,
      row,
      col,
      glow,
      glowDelay: glow ? getGlowDelay(row, col) : null,
    });
  }
}

const svgWidth = COLS * HEX_W + HEX_W; // extra width for odd-row offset
const svgHeight = ROWS * ROW_H + HEX_H;
---

<div class="honeycomb-bg" aria-hidden="true">
  <div class="honeycomb-drift">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="honeycomb-svg"
      viewBox={`${-HEX_W} ${-HEX_H / 2} ${svgWidth + HEX_W} ${svgHeight + HEX_H}`}
      preserveAspectRatio="xMidYMid slice"
    >
      {/* Grid lines — all hexagons as strokes */}
      <g class="honeycomb-grid">
        {hexCells.map(({ cx, cy }) => (
          <path d={path} transform={`translate(${cx},${cy})`} />
        ))}
      </g>

      {/* Glow hexagons — separate layer for pulsing fills */}
      <g class="honeycomb-glows">
        {hexCells
          .filter((h) => h.glow)
          .map(({ cx, cy, glowDelay }) => (
            <path
              d={path}
              transform={`translate(${cx},${cy})`}
              class="honeycomb-glow-hex"
              style={`animation-delay: ${glowDelay}s;`}
            />
          ))}
      </g>
    </svg>
  </div>

  {/* Gradient overlays: top and bottom fade to bg-primary */}
  <div class="honeycomb-fade-top"></div>
  <div class="honeycomb-fade-bottom"></div>
</div>

<style>
  /* Container — absolute fill, behind content */
  .honeycomb-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Drift wrapper — subtle floating movement */
  .honeycomb-drift {
    position: absolute;
    /* Slightly oversized so drift doesn't reveal edges */
    inset: -1.5rem;
    animation: honeycomb-drift 20s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes honeycomb-drift {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(6px, -4px);
    }
    50% {
      transform: translate(-4px, 6px);
    }
    75% {
      transform: translate(4px, 2px);
    }
  }

  /* SVG fills the drift wrapper */
  .honeycomb-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Grid stroke style */
  .honeycomb-grid path {
    fill: none;
    stroke: var(--color-border-subtle);
    stroke-width: 1;
    opacity: 0.18;
  }

  /* Glow hexagons — pulsing fill */
  .honeycomb-glow-hex {
    fill: var(--color-accent);
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0;
    animation: honeycomb-pulse 4s ease-in-out infinite;
    will-change: opacity;
  }

  @keyframes honeycomb-pulse {
    0%,
    100% {
      opacity: 0;
    }
    40%,
    60% {
      opacity: 0.08;
    }
  }

  /* Top gradient fade */
  .honeycomb-fade-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6rem;
    background: linear-gradient(
      to bottom,
      var(--color-bg-primary) 0%,
      transparent 100%
    );
    z-index: 1;
  }

  /* Bottom gradient fade */
  .honeycomb-fade-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 8rem;
    background: linear-gradient(
      to top,
      var(--color-bg-primary) 0%,
      transparent 100%
    );
    z-index: 1;
  }

  /* Reduced motion: disable all animations, show static grid */
  @media (prefers-reduced-motion: reduce) {
    .honeycomb-drift {
      animation: none;
    }

    .honeycomb-glow-hex {
      animation: none;
      opacity: 0.05;
    }
  }
</style>

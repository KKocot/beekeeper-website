---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Beekeeper — Secure Key Management for Hive Blockchain",
  description = "Standalone wallet daemon with HTTP/WebSocket API. Sign transactions without a full node. Native C++ daemon and @hiveio/beekeeper npm package.",
} = Astro.props;

const canonicalUrl = "https://beekeeper.hive.io";
const ogImage = "https://beekeeper.hive.io/og-image.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><path d='M16 2L28.124 9V23L16 30L3.876 23V9L16 2Z' fill='%23F5A623'/><path d='M16 8L23.062 12V20L16 24L8.938 20V12L16 8Z' fill='%230C0C0F' fill-opacity='0.3'/></svg>" />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C0C0F" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body class="bg-bg-primary text-text-primary font-sans min-h-screen antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:text-bg-primary focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold"
    >
      Skip to content
    </a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
